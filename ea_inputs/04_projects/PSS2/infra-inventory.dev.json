  "stages": [
    { "name": "Generate", "text": "Runs generate_tf_config.py for dev and publishes generated backend/tfvars artifacts." },
    { "name": "FoundationDeploy", "text": "Applies 01-foundation and creates network, platform, and app resource groups." },
    { "name": "NetworkDeploy", "text": "Runs when network_mode is managed. Applies VNet, subnets, NSG, route table, and spoke peering." },
    { "name": "PlatformDeploy", "text": "Applies ACR, Log Analytics, and Application Insights." },
    { "name": "Plan / Apply", "text": "Plans and applies the selected workload layer using the reviewed plan artifact." },
    { "name": "AppBuild", "text": "Builds/pushes the container image, restarts the Web App, and zip deploys the Function App." }
  ],
  "layerHierarchy": [
    {
      "title": "01 Foundation",
      "children": [
        { "id": "rg-network" },
        { "id": "rg-platform" },
        { "id": "rg-app" }
      ]
    },
    {
      "title": "02 Network",
      "children": [
        {
          "id": "vnet",
          "children": [
            {
              "label": "Subnets",
              "type": "Contained in VNet",
              "pillar": "network",
              "children": [
                { "id": "subnet-appservice" },
                { "id": "subnet-private-endpoints" },
                { "id": "subnet-apps" }
              ]
            },
            {
              "label": "Subnet controls",
              "type": "Associated to all subnets",
              "pillar": "network",
              "children": [
                { "id": "nsg" },
                { "id": "route-table" }
              ]
            },
            {
              "label": "Peering boundary",
              "type": "Spoke-side plus external hub",
              "pillar": "network",
              "children": [
                { "id": "spoke-peering" },
                { "id": "hub-vnet" }
              ]
            }
          ]
        }
      ]
    },
    {
      "title": "03 Platform",
      "children": [
        { "id": "acr" },
        { "id": "law", "children": [{ "id": "appi" }] }
      ]
    },
    {
      "title": "04 Workload",
      "children": [
        { "id": "plan", "children": [{ "id": "webapp" }, { "id": "function" }] },
        { "id": "storage" },
        { "id": "keyvault" },
        { "id": "sql-server", "children": [{ "id": "sql-db" }] }
      ]
    }
  ],
  "boundaryNotes": [
    {
      "title": "Hub side remains external",
      "text": "The repo creates only the spoke-side peering. The reciprocal peering from M3-VNET-DISTP01 back to M3-VNET-OPS-D-1 is owned by the hub/network team."
    },
    {
      "title": "Private DNS is not created",
      "text": "No private DNS zones are deployed yet. Add or link zones only when private endpoints are introduced."
    },
    {
      "title": "App Service is not VNet integrated",
      "text": "The App Service subnet is ready and delegated, but the workload module does not yet attach the web app to the subnet."
    }
  ]
}
