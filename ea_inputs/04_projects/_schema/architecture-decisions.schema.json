{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Architecture Decisions",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "entries"],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "version", "date", "approval_status", "sha256", "processed_at"],
      "properties": {
        "document": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "format": "date" },
        "approval_status": { "enum": ["review_candidate", "approved", "unknown"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "processed_at": { "type": "string", "format": "date" }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "kind", "status", "position", "systems", "rationale", "source_sections"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["decision", "constraint", "open_question"] },
          "status": { "enum": ["stated", "proposed", "open", "deferred"] },
          "position": { "type": "string", "minLength": 1 },
          "systems": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "rationale": { "type": ["string", "null"], "minLength": 1 },
          "source_sections": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
